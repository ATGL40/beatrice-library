{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: only what the app uses",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "mailto:beatrice2library@gmail.com*" }] },
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
